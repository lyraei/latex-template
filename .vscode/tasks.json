{
    // Silnik, katalog wyjściowy i obsługa biber są w ../.latexmkrc.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (latexmk)",
            "type": "shell",
            "command": "latexmk",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": {
                "owner": "latex",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(?:\\./)?([^:\\s][^:]*\\.(?:tex|cls|sty)):(\\d+):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            },
            "presentation": { "reveal": "silent", "revealProblems": "onProblem", "clear": true }
        },
        {
            "label": "Clean (keep PDF)",
            "type": "shell",
            "command": "latexmk",
            "args": ["-c"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean (full, incl. PDF)",
            "type": "shell",
            "command": "latexmk",
            "args": ["-C"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
